# Default configuration settings applied globally
#
# Keep this file non-readable for group and others (chmod 640): authpf-api refuses to load a
# configuration that is group- or world-readable, and no parameter value is checked before that.
defaults:
  # Path to the pfctl binary executable
  # Absolute path, or a program name looked up in PATH. Must be a regular file
  # with an execute bit, otherwise startup is aborted.
  pfctlBinary: /sbin/pfctl

# AuthPF-specific configuration
authpf:
  # AuthPF anchor activity timeout (e.g., 30m, 1h)
  # Go duration, at least 1s and at most 24h (no "d" unit); an unusable value
  # aborts startup
  timeout: 30m

  # Root directory where user-specific rule files are stored
  # Absolute path to an existing, readable directory. The directory is never
  # created by authpf-api; a missing or unreadable folder aborts startup.
  userRulesRootFolder: /etc/authpf/users

  # Filename for user rules within the userRulesRootFolder
  # Plain file name: no "/", no "\", no "..", no leading dot, characters [A-Za-z0-9_.]
  userRulesFile: authpf.rules

  # Name of the PF anchor to use for rule management
  # Characters [A-Za-z0-9_.] only, no "-": anchorName: authpf-api is rejected at
  # startup. Must match the anchor configured in /etc/pf.conf.
  anchorName: authpf

  # Set flush targets for pfctl command. Every entry is flushed separately as
  # "pfctl -a <anchorName>/<user>(<userId>) -F <target>".
  # Allowed values: nat, queue, ethernet, rules, states, info, Tables, osfp, all
  # Sources and Reset are rejected: they act on global state, not on the anchor.
  flushFilter:
    - nat
    - queue
    - ethernet
    - rules
    - info

  # Flush anchors on startup API. 
  # Two options available: import and importflush.
  # - import: only import existing anchors in authpf/ (default anchorbase, see: anchorName) 
  #     Parse format is: user(UserID)
  #     Example: "authpf/user(2000)" will import, "authpf/user" will not import
  # - importflush: same as import but in addition it remove all anchors to get a clean state for startup
  #
  # Limitations with import:
  #   1. The UserIP cannot be detected from pf. The imported user gets its UserIP from
  #      rbac.users.<name>.userIp. Without userIp the UserIP stays "unknown": the anchor is still
  #      unloaded, but its pfTable entry must be removed by hand (pfctl -t <table> -T delete <ip>),
  #      the api logs a warning with that command.
  #   2. The Expire Datetime will calculate by the `authpf.timeout` and current server time.
  #
  # Any other value aborts startup.
  onStartup: importflush # none, import, importflush

  # Graceful-Shutdown
  #  Options: none, flushall
  #    flushall: Remove all activated user rules when api server get shutdown
  #  Any other value aborts startup.
  onShutdown: flushall

  # Global PF Table to use for the remote client IP addresses
  # Characters [A-Za-z0-9_.]; the table must exist in /etc/pf.conf, a missing
  # table aborts startup. Leave empty to disable table tracking.
  pfTable: authpf_users

  # Time-interval of the scheduler loop, as bare seconds (60) or a Go duration
  # ("90s", "2m", "720h"; no "d" unit). Between 1s and 30 days, an unusable
  # value aborts startup. Above 30 minutes it is accepted with a warning, since
  # anchors then stay active up to one full interval past their own timeout.
  # (default: 60s)
  # schedulerInterval: 60

# Server configuration
server:
  # IP address to bind the server to (127.0.0.1 for localhost only)
  # An IPv4/IPv6 address literal or the name "localhost"; IPv6 in brackets
  # ([::1]), because the port is appended as "<bind>:<port>". No hostname,
  # no "host:port", no CIDR - they abort startup.
  bind: 127.0.0.1

  # Port number for the HTTP/HTTPS server
  port: 8080

  # SSL/TLS configuration
  # Certificate and key are parsed and matched as a pair at startup, so a
  # corrupt file or a key that does not belong to the certificate aborts
  # startup. Configuring only one of the two is an error too. Leave both empty
  # to disable SSL (plain HTTP).
  ssl:
    # Path to SSL certificate file (empty: SSL disabled)
    certificate:
    # Path to SSL private key file (must belong to the certificate)
    key:

  # JWT secret key for token signing - MUST be changed before production deployment
  # At least 32 characters; a shorter or whitespace-only value aborts startup.
  # If empty or missing, a random Secret will be generated 
  jwtSecret: your-secret-key-change-in-production

  # JWT token timeout in hours (default: 8 hours if not set)
  # A bare number is hours (8); the units m, h and d are also accepted (30m, 1h, 2d),
  # up to a maximum of 30 days. Unlike authpf.timeout, the "d" unit IS allowed here.
  # An unusable value aborts startup.
  jwtTokenTimeout: 8

  # Elevator mode for privilege escalation
  # Allowed values are exactly: none, sudo, doas (case sensitive).
  # sudo/doas must be found in PATH, otherwise startup is aborted.
  # Required when running server as non-root user (recommended)
  # 
  # Examples:
  #
  # sudo:
  #   Cmnd_Alias AUTHPF_API_COMMANDS = /sbin/pfctl -sA, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -D user_ip=[0-9.]+ -D user_id=[0-9]+ -f /etc/authpf/users/[a-zA-Z0-9_-]+/authpf.rules$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F nat$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F rules$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F queue$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F states$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F Tables$, \
  #      /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -F all$
  #      /sbin/pfctl ^-t [a-zA-Z0-9_]+ -T add [0-9a-fA-F:.]+$, \
  #      /sbin/pfctl ^-t [a-zA-Z0-9_]+ -T delete [0-9a-fA-F:.]+$, \
  #      /sbin/pfctl ^-t [a-zA-Z0-9_]+ -T show$
  #   %_authpf-api ALL=(root)  NOPASSWD: AUTHPF_API_COMMANDS
  #
  # doas:
  #   # No regular expression for arguments available
  #   permit nopass :authpf as root cmd /sbin/pfctl 
  #
  #   # More secure, use wrapper script for pfctl (see scripts/pfctl_wrapper.go)
  #   # in authpf-api.conf set: defaults.pfctlBinary to /usr/local/sbin/pfctl_wrapper
  #   permit nopass :authpf as root cmd /usr/local/sbin/pfctl_wrapper
  #
  elevatorMode: none

  # Path to the server logfile
  # Relative paths are allowed. The file is opened (created, mode 0640) on every
  # startup - also with -foreground, which logs to stdout - so a wrong path or
  # an unwritable directory aborts startup.
  logfile: /var/log/authpf-api.log

# Role-Based Access Control (RBAC) configuration
# Everything in this section is checked at startup; the first violation aborts the server.
rbac:
  # Role definitions with associated permissions
  # Allowed permission values (empty lists are allowed):
  #   activate_own_rules, activate_other_rules, deactivate_own_rules,
  #   deactivate_other_rules, view_own_rules, view_other_rules
  roles:
    # Administrator role with full permissions
    admin:
      permissions:
        - deactivate_other_rules  # Allow user to activate their own rules
        - deactivate_own_rules    # Allow user to activate rules from other users
        - view_other_rules        # Allow user to view the status of their own loaded rules
        - view_own_rules          # Allow user to view the status of loaded rules from all users
        - activate_other_rules    # Allow user to unload/deactivate their own rules
        - activate_own_rules      # Allow user to unload/deactivate rules from other users
    # Regular user role with limited permissions
    user:
      permissions:
        - activate_own_rules
        - deactivate_own_rules
        - view_own_rules
  
  # User account definitions with credentials and role assignments
  # At least one user is required. User names must match [a-zA-Z0-9_-]+ and be
  # at most 255 characters. userId must not be negative; positive values must
  # be unique, 0 or an omitted userId keep the default behaviour.
  users:
    # Administrator test account
    authpf-admin:
      # Bcrypt password hash. The placeholder below does not start the server:
      # any value that is not a bcrypt hash is rejected at startup.
      # generate: echo -n "testing" | authpf-api -gen-user-password
      password: $2a$10$abcdefg.....
      # Role assigned to this user (must be defined under rbac.roles)
      role: admin
      # Numeric user ID
      userId: 1000
      # User PF Table to use for the remote client IP addresses (global pfTable will ignored if set)
      pfTable: authpf_users

    # Example User
    authpf-user1:
      # Bcrypt password hash (generate: echo -n "testing" | authpf-api -gen-user-password)
      password: $2a$10$hijklmni.....

      # Role assigned to this user (must be defined under rbac.roles)
      role: user

      # Numeric user ID (optional - defaults to 0 if not set)
      userId: 1001

      # Set the userIP to a fixed value (the remote client ip will be ignored, to use client ip remove userIp)
      userIp: 192.168.0.10

      # User defined macros (Key/Value pairs)
      # Important: each macro should be defined in the authpf rule from the user too
      #   If using elevatorMode, update the pf arguments to support the defined macros too to avoid errors
      #   Example (sudo): /sbin/pfctl ^-a authpf/([a-zA-Z0-9_-]+)(\([0-9]+\))? -D [a-zA-Z0-9_-]+=[a-zA-Z0-9_-]+ -f /etc/authpf/users/[a-zA-Z0-9_-]+/authpf.rules$, \

      macros:
        server_1_port: 22 
        server_1_addr: 10.127.2.1

# Extensions configuration (optional - leave the section out to run without extensions)
#   * every entry needs a name matching ^[A-Za-z0-9][A-Za-z0-9._-]*$
#   * each name may only be listed once, a duplicate is loaded twice and is rejected at startup
#   * unknown names abort startup (see: authpf-api -list-extensions)
#   * keys under config: are validated by the extension itself, not by authpf-api. That includes
#     the rbac file of file-rbac: it is not checked by the rbac.* startup validation below
#extensions:
#  - name: prometheus-metrics
#  - name: rate-limit
#    config:
#      rate: 10        # requests per second
#      burst: 30       # burst allowance
#      expiresIn: 10m  # stale entry cleanup interval
#  - name: file-rbac
#    config:
#      file: /usr/local/etc/authpf-api/rbac.yaml
#      watch: true     # enable fsnotify hot-reload
